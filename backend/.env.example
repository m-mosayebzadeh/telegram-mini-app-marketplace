# Copy this file to ".env" and fill in the real values there.
# ".env" must never be committed to git (it's listed in .gitignore).

# Telegram bot token — get it from BotFather.
# This is a secret value; never print it in code, logs, or messages.
TELEGRAM_BOT_TOKEN=

# Enables developer-only routes (currently: /dev/test-init-data).
# Leave unset/false by default. Only set to true for local testing, and
# NEVER while a tunnel (cloudflared/ngrok) is forwarding this server to
# the internet — see the comment in app/core/config.py for why.
ENABLE_DEV_TOOLS=false
