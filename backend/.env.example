# The server's settings (TECHNICAL_REQUIREMENTS.md section 41).
#
# They all live in Infisical, one environment per place (development for
# the two development machines, production for the main server). The server
# fetches them itself as it starts (app/core/infisical.py); the machine holds
# only three environment variables, never in a file:
#     INFISICAL_UNIVERSAL_AUTH_CLIENT_ID      this machine's identity
#     INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET  in Infisical
#     COSMOS_ENV                              dev or prod: which settings
# This file only lists the settings' names and what each one is, for whoever
# adds a value in Infisical. A local ".env" still works for somebody without
# an identity and must never be committed (it is in .gitignore).
#
# The tests need none of this (tests/conftest.py sets its own).

# Postgres. Holds the database password: a secret.
DATABASE_URL=postgresql+psycopg://marketplace:devpass@localhost:5433/marketplace
# Redis: live events across several servers, and waking a device waiting to
# sign in. Without it each server only hears its own people.
REDIS_URL=redis://127.0.0.1:6380/0

# Developer-only routes and the test sign-in. Never true on the main server.
ENABLE_DEV_TOOLS=false
# The session cookie is sent only over HTTPS unless this is false: false for
# local development over plain http, never on the main server.
SESSION_COOKIE_SECURE=true
# The owner's Telegram id: full staff rights from the start.
OWNER_TELEGRAM_ID=

# Our Telegram bot: its token (a secret) and @username, and a random secret
# Telegram sends back with every update, so nobody else can pretend to be
# Telegram — python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Google sign-in: the Client ID from Google Cloud, and where Google sends
# people back (exactly as registered there under "Authorized redirect URIs").
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:5174/api/auth/google/callback

# Notifications when the app is closed: a key pair made once per
# environment with  python scripts/make_vapid_keys.py  (the private half is
# a secret), and who push services contact if something is wrong.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Top-up by card transfer (the paid layer, switched off for now).
TOPUP_CARD_NUMBER=
TOPUP_CARD_HOLDER_NAME=
