meta {
  name: Get My Profile
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/profile/me
  body: none
  auth: none
}

headers {
  X-Telegram-Init-Data: {{initData}}
}

docs {
  404 until you've called "Update My Profile" at least once. Run
  "Generate Test InitData" (Auth folder) first if "initData" is stale.
}
