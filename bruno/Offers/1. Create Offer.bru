}

post {
  url: {{baseUrl}}/offers
  body: json
  auth: none
}

headers {
  X-Telegram-Init-Data: {{initData}}
}

body:json {
  {
    "price_stars": 10,
    "display_duration_minutes": 30,
    "description": "A friendly chat"
  }
}

script:post-response {
  bru.setEnvVar("offerId", res.getBody().id);
}
