meta {
  name: 2. List Photos
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/photos?profile_id=1
  body: none
  auth: none
}

params:query {
  profile_id: 1
}

headers {
  X-Telegram-Init-Data: {{initData}}
}

docs {
  profile_id=1 assumes User A was the first profile ever created locally
  — adjust if not. Only photos the caller is allowed to know about show
  up here; send this same request with {{initDataB}} instead to see the
  difference for a restricted photo.
}
