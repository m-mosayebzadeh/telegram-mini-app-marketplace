meta {
  name: 5. Reveal Original
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/photos/{{photoId}}/original
  body: none
  auth: none
}

headers {
  X-Telegram-Init-Data: {{initData}}
}

docs {
  The "tap to reveal" action. For a free blurred photo this always
  succeeds. For a paid one without a purchase, expect 402 with
  {"reason": "payment_required", "price_stars": N} — run "6. Purchase
  Photo" first to unlock it, then retry this.
}
