meta {
  name: 3. Get Content Metadata
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/content/{{contentId}}
  body: none
  auth: none
}

headers {
  X-Telegram-Init-Data: {{initData}}
}

docs {
  Includes "can_see_original" — whether *this* viewer can currently see
  the real content (spoiler lifted) — "has_spoiler", "like_count", and
  "liked_by_me".
}
