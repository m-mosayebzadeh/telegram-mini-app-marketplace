meta {
  name: Get Me
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/me
  body: none
  auth: none
}

headers {
  X-Telegram-Init-Data: {{initData}}
}

script:post-response {
  bru.setEnvVar("userIdA", res.getBody().id);
}

docs {
  Requires a valid, freshly-signed Telegram initData string in the
  "initData" environment variable.

  Run "Generate Test InitData" (in this same folder) first — its script
  fills "initData" for you automatically. auth_date expires after
  TELEGRAM_AUTH_MAX_AGE_SECONDS (24h by default), so just re-run it if
  this request starts returning 401.
}
